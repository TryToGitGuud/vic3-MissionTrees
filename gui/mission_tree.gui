	type mt_french_politics_tree = container {
		visible = "[GetScriptedGui('mt_has_fra_tree').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		size = { @mt_canvas_width @mt_canvas_height }
		parentanchor = hcenter

		default_header = {
			position = { 0 0 }
			blockoverride "text" { text = "MT_FRA_POLITICAL_TREE_HEADER" }
		}

		# Monarchist path: three competing dynastic currents become one settlement.
		container = {
			visible = "[GetScriptedGui('mt_has_fra_monarchist_path').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			size = { @mt_canvas_width @mt_canvas_height }
			mt_mission_button = { position = { @mt_col_3 @mt_row_1 } blockoverride "mission_title" { text = "mt_fra_political_m01" } blockoverride "mission_icon" { texture = "gfx/interface/icons/event_icons/mt_france_royal_arms.dds" } blockoverride "mission_tooltip" { tooltip = "mt_fra_political_m01_full_tt" } blockoverride "mission_conditions_tooltip" { tooltip = "mt_fra_political_m01_conditions_tt" } blockoverride "mission_reward_tooltip" { tooltip = "[GetScriptedGui('mt_fra_political_m01_reward').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } blockoverride "mission_onclick" { onclick = "[GetScriptedGui('mt_fra_political_m01_claim').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } blockoverride "mission_completed_visibility" { visible = "[GetScriptedGui('mt_fra_political_m01_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } blockoverride "mission_available_visibility" { visible = "[GetScriptedGui('mt_fra_political_m01_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } blockoverride "mission_locked_visibility" { visible = "[And(Not(GetScriptedGui('mt_fra_political_m01_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)), Not(GetScriptedGui('mt_fra_political_m01_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" } }
			mt_arrow_down_left = { position = { @mt_col_2 @mt_arrow_y_1 } }
