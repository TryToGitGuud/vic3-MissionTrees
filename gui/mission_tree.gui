	type mt_mission_button = button {
		size = { @mt_node_width @mt_node_height }
		block "mission_onclick" {}
		block "mission_tooltip" {}
		using = tooltip_below
		onmousehierarchyenter = "[PdxGuiWidget.FindChild('mission_hover_highlight').InterruptThenTriggerAnimation('mission_hover_hide','mission_hover_show')]"
		onmousehierarchyleave = "[PdxGuiWidget.FindChild('mission_hover_highlight').InterruptThenTriggerAnimation('mission_hover_show','mission_hover_hide')]"

		icon = {
			block "mission_available_visibility" {
				visible = no
			}
			texture = "gfx/interface/missions/mission_icons_frame.dds"
			size = { 103 123 }
			position = { 0 0 }
		}

		icon = {
			block "mission_completed_visibility" {
				visible = no
			}
			texture = "gfx/interface/missions/mission_icons_frame_complete.dds"
			size = { 103 123 }
			position = { 0 0 }
		}

		icon = {
			block "mission_locked_visibility" {
				visible = no
			}
			texture = "gfx/interface/missions/mission_icons_frame_locked.dds"
			size = { 103 123 }
			position = { 0 0 }
		}

		# EU4-style hover: the mission frame receives a brief golden highlight.
		icon = {
			name = mission_hover_highlight
			texture = "gfx/interface/missions/mission_icons_frame_complete.dds"
			size = { 103 123 }
			position = { 0 0 }
			alpha = 0
			alwaystransparent = yes

			state = {
				name = mission_hover_show
				alpha = 0.42
				duration = 0.12
				using = Animation_Curve_Default
			}

			state = {
				name = mission_hover_hide
				alpha = 0
				duration = 0.2
				using = Animation_Curve_Default
			}
		}

		icon = {
			block "mission_icon" {
				texture = "gfx/interface/missions/mission_placeholder.dds"
			}
			size = { @mt_icon_width @mt_icon_height }
			position = { 22 20 }
		}

		textbox = {
			block "mission_title" {
				text = "MT_MISSION_PLACEHOLDER"
			}
			# EU4 mission labels sit on the two lower blue nameplates.
			size = { 90 34 }
			maximumsize = { 90 34 }
			minimumsize = { 90 34 }
			multiline = yes
			autoresize = no
			align = top|hcenter|nobaseline
			default_format = "#white;bold"
			using = fontsize_small
			position = { 8 84 }
		}

		icon = {
			block "mission_conditions_tooltip" {
				tooltip = "MT_MISSION_CONDITIONS_TT"
			}
			using = tooltip_below
			texture = "gfx/interface/missions/mission_trigger.dds"
			size = { 33 33 }
			position = { 0 7 }
		}

		icon = {
			block "mission_available_visibility" {
				visible = no
			}
			texture = "gfx/interface/missions/mission_effect_glow.dds"
			size = { 56 56 }
			position = { 58 -4 }
		}

		icon = {
			block "mission_reward_tooltip" {
				tooltip = "MT_MISSION_REWARD_TT"
			}
			using = tooltip_below
			texture = "gfx/interface/missions/mission_effect.dds"
			# The EU4 texture is a horizontal three-frame strip; display one frame.
			size = { 33 33 }
			framesize = { 33 33 }
			frame = 0
			position = { 70 7 }
		}

	}

