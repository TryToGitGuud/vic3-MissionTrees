				blockoverride "mission_onclick" { onclick = "[GetScriptedGui('mt_fra_mission_04_claim').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_completed_visibility" { visible = "[GetScriptedGui('mt_fra_mission_04_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_available_visibility" { visible = "[GetScriptedGui('mt_fra_mission_04_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_locked_visibility" { visible = "[And(Not(GetScriptedGui('mt_fra_mission_04_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)), Not(GetScriptedGui('mt_fra_mission_04_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" }
