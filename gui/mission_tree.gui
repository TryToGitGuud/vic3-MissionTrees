types mission_tree
{
	type mission_tree_panel = container {
		size = { @mt_panel_width @mt_canvas_height }
		parentanchor = hcenter

		empty_state = {
			visible = "[Not(GetScriptedGui('mt_has_active_tree').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			parentanchor = vcenter|hcenter

			blockoverride "text" {
				text = "MT_NO_MISSION_TREE"
			}
		}

		container = {
			visible = no
			size = { @mt_canvas_width @mt_canvas_height }
			parentanchor = hcenter

			default_header = {
				position = { 0 0 }
				blockoverride "text" {
					text = "MT_FRA_TREE_HEADER"
				}
			}

			### Row 1
			mt_mission_button = {
				position = { @mt_col_3 @mt_row_1 }
				blockoverride "mission_title" { text = "mt_fra_mission_01" }
				blockoverride "mission_icon" { texture = "gfx/interface/icons/event_icons/event_trade.dds" }
				blockoverride "mission_tooltip" { tooltip = "mt_fra_mission_01_tt" }
				blockoverride "mission_conditions_tooltip" { tooltip = "mt_fra_mission_01_conditions_tt" }
				blockoverride "mission_onclick" { onclick = "[GetScriptedGui('mt_fra_mission_01_claim').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_completed_visibility" { visible = "[GetScriptedGui('mt_fra_mission_01_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_available_visibility" { visible = "[GetScriptedGui('mt_fra_mission_01_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
				blockoverride "mission_locked_visibility" { visible = "[And(Not(GetScriptedGui('mt_fra_mission_01_claim').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)), Not(GetScriptedGui('mt_fra_mission_01_done').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]" }
			}

			### Row 1 arrows
			mt_arrow_down_right = { position = { @mt_col_3 @mt_arrow_y_1 } }
			mt_arrow_down = { position = { @mt_col_3 @mt_arrow_y_1 } }
			mt_arrow_down_left = { position = { @mt_col_2 @mt_arrow_y_1 } }

			### Row 2
			mt_mission_button = {
				position = { @mt_col_4 @mt_row_2 }
				blockoverride "mission_title" { text = "mt_fra_mission_04" }
				blockoverride "mission_icon" { texture = "gfx/interface/icons/event_icons/event_trade.dds" }
